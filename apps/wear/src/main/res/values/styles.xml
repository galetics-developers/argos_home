<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash screen of the watch app. The background uses the brand color instead of the
    default black so the launch matches the phone app. The value repeats primary-600 of
    the Compose palette in presentation/theme/Color.kt because the platform splash
    screen is resolved before Compose runs.
-->
<resources>

    <style name="MainActivityTheme.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF5E244E</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@android:style/Theme.DeviceDefault</item>
    </style>
</resources>
