<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@array/android_wear_capabilities">

    <!--
        Capability advertised by the phone app so the watch app can discover its node.
        This literal value must stay identical to the CAPABILITY_MOBILE_APP constant in the
        shared Kotlin source; a mismatch breaks node discovery silently.
    -->
    <string-array name="android_wear_capabilities">
        <item>argos_home_mobile_app</item>
    </string-array>

</resources>
