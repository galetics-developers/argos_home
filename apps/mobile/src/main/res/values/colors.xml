<?xml version="1.0" encoding="utf-8"?>
<!--
    Brand colors needed by the XML theme that the system applies before Compose draws
    the first frame. The Compose palette lives in ui/theme/Color.kt; these values repeat
    only the few tones the platform theme needs and must stay in sync with it.
-->
<resources>
    <color name="brand_primary">#FF5E244E</color>
    <color name="brand_primary_dark">#FF4D1E40</color>
    <color name="brand_secondary">#FFAA1C41</color>
    <color name="brand_background">#FFFAFAFA</color>
    <color name="brand_on_primary">#FFFFFFFF</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
</resources>
